{
    "name": "wiseadmin/wise-agent",
    "description": "WiseAdmin AI Agent - AI-powered agent system with memory, tools, and event-driven extensibility for ThinkPHP 8",
    "type": "library",
    "license": "MIT",
    "keywords": ["wiseadmin", "ai", "agent", "llm", "openai", "deepseek"],
    "authors": [
        {
            "name": "WiseAdmin Team"
        }
    ],
    "autoload": {
        "psr-4": {
            "wise\\agent\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\agent\\test\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.0 || ^8.0",
        "topthink/think-orm": "^2.0 || ^3.0",
        "topthink/think-queue": "^3.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0 || ^11.0"
    },
    "suggest": {
        "ext-redis": "Recommended for Redis-based memory store (RedisMemory)"
    },
    "extra": {
        "think": {
            "services": [
                "wise\\agent\\Service"
            ],
            "config": {
                "wise-agent": "config/wise-agent.php"
            },
            "migrate-path": "database/migrations"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
